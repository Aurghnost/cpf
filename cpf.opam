opam-version: "2.0"
version: "0.1"
synopsis: "The C/C++ Programmer's Friend"
description: "C/C++ projects and packages manager"
maintainer: ["Bastien Garnier <bastiengarnier17@proton.me>"]
authors: ["Bastien Garnier <bastiengarnier17@proton.me>"]
license: "MIT"
tags: ["C" "C++" "cpf"]
homepage: "https://github.com/BastienGarnier/cpf"
doc: "https://url/to/documentation"
bug-reports: "https://github.com/BastienGarnier/cpf/issues"
depends: [
  "dune" {>= "3.20"}
  "ocaml"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
